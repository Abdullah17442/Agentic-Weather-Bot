# Copy this file to weather_agent/.env and fill in your key.
# .env is git-ignored; never commit a real key. Leave this file blank.

# OpenWeather current-weather API key. If blank, the free Open-Meteo fallback is used.
OPENWEATHER_API_KEY=

# Use the Gemini API (Google AI Studio) rather than Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Your Gemini API key (google-genai also accepts GOOGLE_API_KEY). Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
